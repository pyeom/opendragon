# Builds the checkout this file lives in:  cd packaging/arch && makepkg -si
pkgname=opendragon
pkgver=0.1.0
pkgrel=1
pkgdesc="Battery, DPI, button mapping and macros for Redragon wireless mice"
url="https://github.com/pyeom/opendragon"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs')
makedepends=('cmake')
source=()

build() {
  cmake -S "$startdir/../.." -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
